# Copy to .env and fill in as they become available.

# --- Gemini (nano-banana) ---
# Leave blank in dev; the backend falls back to a deterministic regex extractor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Stable Diffusion + ControlNet endpoint ---
# Point this to the ngrok URL printed by colab/sd_controlnet_server.ipynb, e.g.
# SD_CONTROLNET_URL=https://xxxx-xx-xx.ngrok-free.app
# Leave blank in dev; the SD client will return the control image as a stub.
SD_CONTROLNET_URL=
SD_TIMEOUT_SECONDS=180

# --- App ---
APP_ENV=dev
CORS_ORIGINS=http://localhost:3000
